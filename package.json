{
  "name": "dota2-cn-wiki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:sync": "node scripts/sync-data.mjs",
    "data:sync:fast": "node scripts/sync-data.mjs --no-liquipedia",
    "data:sync:esports": "node scripts/sync-esports.mjs",
    "data:sync:mechanics": "node scripts/sync-mechanics.mjs",
    "data:sync:item-structures": "node scripts/sync-item-structures.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "toy:build": "node scripts/build-toy.mjs --download-assets",
    "toy:pack": "node scripts/build-toy.mjs --download-assets --zip",
    "toy:build:fast": "node scripts/build-toy.mjs",
    "toy:validate": "node scripts/validate-toy.mjs --strict-assets",
    "vercel:build": "node scripts/build-toy.mjs --download-assets && node scripts/validate-toy.mjs --strict-assets"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotaconstants": "^10.8.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
